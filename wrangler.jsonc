{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codigo-fuentes",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PAYMENT_API_URL": "https://mercadopago-api.gabriel-fer-fuentes.workers.dev"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codigo-fuentes-db",
      "database_id": "fbb42342-f1b9-4c75-818c-9e57034b1854"
    }
  ]
}
